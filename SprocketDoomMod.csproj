    <EmbeddedResource Include="sounds\shotgun_fire.wav" LogicalName="DoomAssets.shotgun_fire.wav" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(BepInExCoreDir)\*.dll" Exclude="$(BepInExCoreDir)\TerraFX*.dll;$(BepInExCoreDir)\dobby.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(BepInExInteropDir)\*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins"
          Condition="Exists('$(BepInExDir)\plugins')" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="$(AssemblyName) v$(Version) -> $(BepInExDir)\plugins"
             Condition="Exists('$(BepInExDir)\plugins')" />
  </Target>

</Project>
